# ARARE backend runtime configuration
# These variables override the defaults in
# src/main/resources/application.properties.
# Export them in your shell (or set them in your process manager) before
# running `mvn spring-boot:run`.

# JDBC URL of the PostgreSQL database managed by ARARE.
# Flyway creates and migrates the schema; the database itself must exist.
ARARE_DB_URL=jdbc:postgresql://localhost:5432/araredb

# PostgreSQL role the application connects as.
ARARE_DB_USERNAME=postgres

# Password for ARARE_DB_USERNAME. Defaults to 123456 when unset (local dev
# only). OVERRIDE this for any non-local / shared deployment — the default is
# a weak, well-known value. Set it in your environment; never commit real
# passwords to VCS.
ARARE_DB_PASSWORD=

# Comma-separated list of CORS origins allowed to call the REST API.
# Defaults to http://localhost:5173 when unset. Use * only for local
# development — never combine a wildcard with credentialed requests.
ARARE_CORS_ORIGINS=http://localhost:5173
